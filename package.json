{
  "name": "profile-sync",
  "version": "1.0.0",
  "description": "Manual maintenance of developer portfolios and profile READMEs leads to stale metrics, missing project highlights, and outdated statistics.",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "profile-sync": "src/cli/cli.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "cli": "node --experimental-strip-types src/cli/cli.ts",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "build": "tsc --noEmit"
  },
  "keywords": [
    "enterprise",
    "clean-architecture",
    "local-first",
    "typescript",
    "tsi",
    "zero-dependency",
    "profile-sync"
  ],
  "author": "Felipe Madison (@FelipeMadson)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}